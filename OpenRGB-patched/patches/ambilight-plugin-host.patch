@@ -941,6 +941,26 @@
 bool ResourceManager::ProcessPreDetection()
 {
     /*-----------------------------------------------------*\
+    | A detection that is still winding down -- e.g. after  |
+    | "Stop detection", which only clears                   |
+    | detection_is_required -- holds DetectDeviceMutex      |
+    | until its detection-end callbacks have run. Starting  |
+    | over now would announce a new detection to every      |
+    | listener, let the old one's end callbacks hand them   |
+    | the controller list again, and then delete that list  |
+    | in Cleanup(): anything driving devices (the Ambilight |
+    | plugin) would write to freed controllers. Ignore the  |
+    | request instead; a later rescan works normally.       |
+    \*-----------------------------------------------------*/
+    if(!DetectDeviceMutex.try_lock())
+    {
+        LOG_WARNING("[ResourceManager] Rescan ignored: the previous detection is still finishing");
+        return false;
+    }
+
+    DetectDeviceMutex.unlock();
+
+    /*-----------------------------------------------------*\
     | Process pre-detection hooks                           |
     \*-----------------------------------------------------*/
     ProcessPreDetectionHooks();
