+static bool ShowRunningInstance(int timeout_ms)
+{
+    for(int waited_ms = 0; ; waited_ms += 100)
+    {
+        HANDLE event = OpenEventW(EVENT_MODIFY_STATE, FALSE, L"Local\\OpenRGB_ShowWindow");
+
+        if(event != NULL)
+        {
+            AllowSetForegroundWindow(ASFW_ANY);
+
+            BOOL signalled = SetEvent(event);
+
+            CloseHandle(event);
+            return(signalled != FALSE);
+        }
+
+        if(waited_ms >= timeout_ms)
+        {
+            return(false);
+        }
+
+        std::this_thread::sleep_for(100ms);
+    }
+}
