+/*---------------------------------------------------------*\
+| Single instance (Windows)                                 |
+|                                                           |
+|   The instance that detected the devices (the elevated    |
+|   server started at logon) owns a named event. A plain    |
+|   double-click on OpenRGB.exe runs unelevated; instead of |
+|   opening a client copy of this window -- with plugins    |
+|   that would then run a second time against remote        |
+|   devices -- it sets the event and exits, and this window |
+|   comes forward. See ShowRunningInstance() in             |
+|   startup/main_Windows.cpp, which uses the same name.     |
+|                                                           |
+|   The event's DACL lets the (unelevated) interactive user |
+|   signal it; its label is medium so the elevated creator  |
+|   does not lock a medium-integrity caller out.            |
+\*---------------------------------------------------------*/
+#define OPENRGB_SHOW_WINDOW_EVENT L"Local\\OpenRGB_ShowWindow"
+
+void OpenRGBDialog::StartShowWindowListener()
+{
+#ifdef _WIN32
+    if(show_window_thread)
+    {
+        return;
+    }
+
+    SECURITY_ATTRIBUTES  attributes;
+    PSECURITY_DESCRIPTOR descriptor = NULL;
+
+    if(!ConvertStringSecurityDescriptorToSecurityDescriptorW(
+            L"D:(A;;GA;;;SY)(A;;GA;;;BA)(A;;0x00100002;;;AU)S:(ML;;NW;;;ME)",
+            SDDL_REVISION_1, &descriptor, NULL))
+    {
+        LOG_WARNING("[OpenRGBDialog] Cannot build the show-window event security, error %lu", GetLastError());
+        return;
+    }
+
+    attributes.nLength              = sizeof(attributes);
+    attributes.lpSecurityDescriptor = descriptor;
+    attributes.bInheritHandle       = FALSE;
+
+    HANDLE event = CreateEventW(&attributes, FALSE, FALSE, OPENRGB_SHOW_WINDOW_EVENT);
+    DWORD  error = GetLastError();
+
+    LocalFree(descriptor);
+
+    if(event == NULL || error == ERROR_ALREADY_EXISTS)
+    {
+        /*-------------------------------------------------*\
+        | Another instance already answers to it            |
+        \*-------------------------------------------------*/
+        if(event != NULL)
+        {
+            CloseHandle(event);
+        }
+        return;
+    }
+
+    HANDLE stop = CreateEventW(NULL, TRUE, FALSE, NULL);
+
+    show_window_event  = event;
+    show_window_stop   = stop;
+    show_window_thread = new std::thread([this, event, stop]()
+    {
+        HANDLE handles[2] = { stop, event };
+
+        while(WaitForMultipleObjects(2, handles, FALSE, INFINITE) == WAIT_OBJECT_0 + 1)
+        {
+            QMetaObject::invokeMethod(this, "on_ShowWindowRequested", Qt::QueuedConnection);
+        }
+    });
+#endif
+}
+
+void OpenRGBDialog::StopShowWindowListener()
+{
+#ifdef _WIN32
+    if(show_window_thread)
+    {
+        SetEvent((HANDLE)show_window_stop);
+        show_window_thread->join();
+        delete show_window_thread;
+        show_window_thread = nullptr;
+    }
+
+    if(show_window_event)
+    {
+        CloseHandle((HANDLE)show_window_event);
+        show_window_event = nullptr;
+    }
+
+    if(show_window_stop)
+    {
+        CloseHandle((HANDLE)show_window_stop);
+        show_window_stop = nullptr;
+    }
+#endif
+}
+
+void OpenRGBDialog::on_ShowWindowRequested()
+{
+    if(isHidden())
+    {
+        show();
+    }
+
+    if(isMinimized())
+    {
+        bool maximize = isMaximized();
+        showNormal();
+        if(maximize)
+        {
+            showMaximized();
+        }
+    }
+
+    raise();
+    activateWindow();
+}
