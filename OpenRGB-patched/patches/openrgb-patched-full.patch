+    static NTSETTIMERRESOLUTION NtSetTimerResolution =
+        (NTSETTIMERRESOLUTION)(void *)GetProcAddress(GetModuleHandleW(L"ntdll.dll"), "NtSetTimerResolution");
+
+    ULONG current_resolution;
+
+    if(NtSetTimerResolution != NULL)
