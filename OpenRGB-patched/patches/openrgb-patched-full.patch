+static bool RunElevatedServerTask()
+{
+    wchar_t system_dir[MAX_PATH];
+
+    if(GetSystemDirectoryW(system_dir, MAX_PATH) == 0)
+    {
+        return(false);
+    }
+
+    std::wstring command = L"\"" + std::wstring(system_dir) + L"\\schtasks.exe\" /run /tn \"" ELEVATED_SERVER_TASK_NAME L"\"";
+
+    STARTUPINFOW        startup_info = { };
+    PROCESS_INFORMATION process_info = { };
+    DWORD               exit_code    = 1;
+
+    startup_info.cb = sizeof(startup_info);
+
+    if(!CreateProcessW(NULL, &command[0], NULL, NULL, FALSE, CREATE_NO_WINDOW, NULL, NULL, &startup_info, &process_info))
+    {
+        return(false);
+    }
+
+    if(WaitForSingleObject(process_info.hProcess, 10000) == WAIT_OBJECT_0)
+    {
+        GetExitCodeProcess(process_info.hProcess, &exit_code);
+    }
+
+    CloseHandle(process_info.hThread);
+    CloseHandle(process_info.hProcess);
+
+    return(exit_code == 0);
+}
+
+static bool RelaunchElevated()
+{
+    wchar_t exe_path[MAX_PATH];
+
+    if(GetModuleFileNameW(NULL, exe_path, MAX_PATH) == 0)
+    {
+        return(false);
+    }
+
+    /*-----------------------------------------------------*\
+    | Also serve the SDK, so the elevated instance can be   |
+    | the one everything else (Ambilight) talks to          |
+    \*-----------------------------------------------------*/
+    SHELLEXECUTEINFOW exec_info = { };
+
+    exec_info.cbSize       = sizeof(exec_info);
+    exec_info.lpVerb       = L"runas";
+    exec_info.lpFile       = exe_path;
+    exec_info.lpParameters = L"--gui --server";
+    exec_info.nShow        = SW_SHOWNORMAL;
+
+    return(ShellExecuteExW(&exec_info) == TRUE);
+}
