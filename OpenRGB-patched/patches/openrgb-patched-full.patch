+static void FurySetTimerResolution(ULONG resolution_100ns)
+{
+    typedef LONG (NTAPI *NTSETTIMERRESOLUTION)(ULONG DesiredResolution, BOOLEAN SetResolution, PULONG CurrentResolution);
