+    | board's lighting MCU is a low-speed USB device: a report costs    |
+    | about 93 ms regardless of how many LEDs the zone holds (measured  |
+    | unchanged with zones resized from 60 LEDs down to 4). Four of     |
+    | them is ~370 ms per frame, which not only makes the board trail   |
+    | every other device by a third of a second but starves the other   |
+    | HID devices sharing the bus -- a keyboard that updates in 33 ms   |
+    | on its own was measured at 800 ms while this ran alongside it.    |
+    |                                                                   |
+    | A header with nothing connected is sized to 0 LEDs in OpenRGB and |
+    | never reaches SetLedColor(), so its packet carries nothing and    |
+    | can be left out. Every skipped zone is ~93 ms off the frame time. |
+    \*-----------------------------------------------------------------*/
+    switch(zone)
+    {
+    case MSI_ZONE_JAF:
+        return jaf_per_led_data;
+    case MSI_ZONE_JARGB_1:
+        return jargb1_per_led_data;
+    case MSI_ZONE_JARGB_2:
+        return jargb2_per_led_data;
+    case MSI_ZONE_JARGB_3:
+        return jargb3_per_led_data;
+    default:
+        return true;
     }
 }
 
